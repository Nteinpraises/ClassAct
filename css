:root{
  --bg:#EDF0EE; --panel:#FFFFFF; --ink:#14181B; --muted:#5B6660; --line:#DDE3E0;
  --task:#2F5D8A; --task-bg:#EAF1F8;
  --focus:#D9480F; --focus-bg:#FBEBE3;
  --habit:#3F7D5C; --habit-bg:#E9F3ED;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#12161A; --panel:#1B2126; --ink:#EDEFEE; --muted:#93A19B; --line:#2A3236;
    --task-bg:#1B2A3A; --focus-bg:#33201A; --habit-bg:#1B2C22;
  }
}
:root[data-theme="dark"]{
  --bg:#12161A; --panel:#1B2126; --ink:#EDEFEE; --muted:#93A19B; --line:#2A3236;
  --task-bg:#1B2A3A; --focus-bg:#33201A; --habit-bg:#1B2C22;
}
*{box-sizing:border-box;}
html,body{height:100%;}
body{
  margin:0; background:var(--bg); color:var(--ink);
  font-family:'Inter',system-ui,sans-serif;
}
.wrap{max-width:1080px; margin:0 auto; padding:40px 24px 80px;}
header{display:flex; flex-wrap:wrap; align-items:baseline; justify-content:space-between; gap:16px; margin-bottom:36px;}
.brand{font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:26px; letter-spacing:-0.02em;}
.brand span{color:var(--focus);}
.stats{display:flex; gap:28px;}
.stat{text-align:right;}
.stat b{display:block; font-family:'Space Grotesk',sans-serif; font-size:22px; line-height:1;}
.stat small{color:var(--muted); font-size:12px;}
.grid{display:grid; grid-template-columns:1.3fr 1fr; gap:20px; align-items:start;}
.panel{background:var(--panel); border:1px solid var(--line); border-radius:14px; padding:22px;}
.panel h2{font-family:'Space Grotesk',sans-serif; font-size:17px; margin:0 0 16px; display:flex; align-items:center; gap:8px;}
.dot{width:9px; height:9px; border-radius:50%; display:inline-block;}
.task .dot{background:var(--task);} .focus .dot{background:var(--focus);} .habit .dot{background:var(--habit);}

.add-row{display:flex; gap:8px; margin-bottom:16px;}
input[type=text]{flex:1; padding:10px 12px; border:1px solid var(--line); border-radius:8px; background:var(--bg); color:var(--ink); font:inherit;}
select{padding:10px; border:1px solid var(--line); border-radius:8px; background:var(--bg); color:var(--ink); font:inherit;}
button{cursor:pointer; border:none; border-radius:8px; font:inherit; font-weight:600;}
.btn-task{background:var(--task); color:#fff; padding:10px 16px;}
ul.tasks{list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:8px;}
.task-item{display:flex; align-items:center; gap:10px; padding:10px 12px; border-radius:8px; background:var(--task-bg);}
.task-item.done{opacity:.5;}
.task-item span{flex:1;}
.task-item.done span{text-decoration:line-through;}
.prio{font-size:11px; padding:2px 7px; border-radius:99px; font-weight:600; text-transform:uppercase; letter-spacing:.03em;}
.prio.high{background:#F3C6C6; color:#7A1F1F;} .prio.medium{background:#F5E3B3; color:#7A5C1F;} .prio.low{background:#CFE3D8; color:#1F5A3A;}
.icon-btn{background:none; color:var(--muted); font-size:16px; padding:2px 6px;}
.empty{color:var(--muted); font-size:14px; padding:8px 0;}
.check{width:22px; height:22px; border-radius:50%; border:2px solid var(--task); background:none; flex-shrink:0;}

.timer-face{text-align:center; padding:10px 0 18px;}
.timer-time{font-family:'Space Grotesk',sans-serif; font-size:48px; font-weight:700;}
.timer-mode{color:var(--muted); font-size:13px; margin-bottom:14px;}
.timer-btns{display:flex; gap:8px; justify-content:center;}
.timer-btns button{padding:9px 14px; background:var(--focus-bg); color:var(--focus);}
.sessions{text-align:center; color:var(--muted); font-size:13px; margin-top:12px;}

.habit-add{display:flex; gap:8px; margin-bottom:14px;}
ul.habits{list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:8px;}
.habit-item{display:flex; align-items:center; gap:10px; padding:10px 12px; border-radius:8px; background:var(--habit-bg);}
.habit-item span{flex:1;}
.streak{font-size:12px; color:var(--habit); font-weight:600;}
.habit-check{width:22px; height:22px; border-radius:50%; border:2px solid var(--habit); background:none; flex-shrink:0;}
.habit-check.on{background:var(--habit);}
.btn-habit{background:var(--habit); color:#fff; padding:10px 16px;}

@media (max-width:760px){ .grid{grid-template-columns:1fr;} .stats{gap:18px;} }
